---
// Shared "Написать в Telegram" CTA — the same flat accent button used on the
// delivery page and the order-steps block, so the markup/tracking attrs live
// in one place instead of being copy-pasted per page.
import { TELEGRAM_URL } from "../lib/contacts";

interface Props {
  place: string;
  product?: string;
  class?: string;
}

const { place, product, class: className = "" } = Astro.props;
---

<a
  href={TELEGRAM_URL}
  target="_blank"
  rel="noopener noreferrer"
  data-ym-goal="telegram_click"
  data-ym-place={place}
  data-ym-product={product}
  class={`flex items-center justify-center gap-2 bg-accent px-5 py-3 text-sm font-medium text-bg ${className}`}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M21.5 3.5l-19 7.3c-1 .4-1 1.1-.1 1.4l4.7 1.5 1.8 5.5c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.2-2.1 4.6 3.4c.8.5 1.4.2 1.6-.8l3-14.1c.3-1.3-.3-1.9-1.5-1.4z" />
  </svg>
  Написать в Telegram
</a>
