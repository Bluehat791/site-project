---
import ReviewCard from "./ReviewCard.astro";
import { reviews, REVIEWS_SOURCE_URL } from "../lib/reviews";

const pad = (n: number) => String(n).padStart(2, "0");

const reviewCount = reviews.length;
const averageRating = reviewCount
  ? reviews.reduce((sum, review) => sum + review.rating, 0) / reviewCount
  : 0;

const pluralizeReview = (n: number) => {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return "отзывов";
  if (mod10 === 1) return "отзыв";
  if (mod10 >= 2 && mod10 <= 4) return "отзыва";
  return "отзывов";
};
---

<div>
  {
    reviewCount > 0 && (
      <div class="mb-6 flex items-center gap-2 font-mono text-sm">
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="1.5"
          class="text-sand"
          aria-hidden="true"
        >
          <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" stroke-linejoin="round" />
        </svg>
        <span class="text-accent">{averageRating.toFixed(1)}</span>
        <span class="text-text-muted">
          · {reviewCount} {pluralizeReview(reviewCount)} на Яндекс.Картах
        </span>
      </div>
    )
  }

  <div class="relative">
    <div
      data-reviews-track
      class="no-scrollbar -mx-1 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 pb-2"
    >
      {
        reviews.map((review, index) => (
          <div class="group relative w-[85%] flex-none snap-start sm:w-[calc(50%-8px)] lg:w-[calc((100%-32px)/3)]">
            <ReviewCard review={review} />
            <button
              type="button"
              data-review-open
              data-index={index}
              aria-label={`Открыть отзыв: ${review.author}`}
              class="absolute inset-0 border border-transparent hover:border-line-strong focus-visible:border-line-strong focus-visible:outline-none"
            />
          </div>
        ))
      }
    </div>

    <button
      type="button"
      data-reviews-prev
      aria-label="Предыдущие отзывы"
      class="absolute left-0 top-1/2 hidden h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:flex"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <button
      type="button"
      data-reviews-next
      aria-label="Следующие отзывы"
      class="absolute right-0 top-1/2 hidden h-10 w-10 -translate-y-1/2 translate-x-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:flex"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <div class="mt-6 flex justify-center">
    <a
      href={REVIEWS_SOURCE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-xs text-text-muted hover:text-accent"
    >
      Все отзывы на Яндекс.Картах →
    </a>
  </div>
</div>

<div
  data-reviews-lightbox
  role="dialog"
  aria-modal="true"
  aria-label="Отзыв"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-bg/95 p-4 backdrop-blur-sm sm:p-10"
>
  <div class="relative w-full max-w-2xl">
    <div class="mb-3 flex items-center justify-between">
      <span data-reviews-lightbox-counter data-total={pad(reviews.length)} class="font-mono text-xs text-text-muted"></span>
      <button
        type="button"
        data-reviews-lightbox-close
        aria-label="Закрыть"
        class="flex h-10 w-10 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    {
      reviews.map((review, index) => (
        <div data-reviews-lightbox-slide data-index={index} class="hidden">
          <ReviewCard review={review} variant="full" />
        </div>
      ))
    }

    <div class="mt-3 flex items-center justify-between gap-3">
      <button
        type="button"
        data-reviews-lightbox-prev
        aria-label="Предыдущий отзыв"
        class="flex h-10 w-10 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <a
        href={REVIEWS_SOURCE_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[11px] text-text-muted hover:text-accent"
      >
        Оригинал на Яндекс.Картах →
      </a>
      <button
        type="button"
        data-reviews-lightbox-next
        aria-label="Следующий отзыв"
        class="flex h-10 w-10 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-reviews-track]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-reviews-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-reviews-next]");

  const updateArrows = () => {
    if (!track || !prevBtn || !nextBtn) return;
    const hasOverflow = track.scrollWidth > track.clientWidth + 4;
    prevBtn.classList.toggle("sm:!hidden", !hasOverflow);
    nextBtn.classList.toggle("sm:!hidden", !hasOverflow);
  };

  if (track && prevBtn && nextBtn) {
    const scrollByCard = (direction: 1 | -1) => {
      const card = track.querySelector<HTMLElement>(":scope > div");
      const amount = card ? card.getBoundingClientRect().width + 16 : track.clientWidth;
      track.scrollBy({ left: amount * direction, behavior: "smooth" });
    };

    prevBtn.addEventListener("click", () => scrollByCard(-1));
    nextBtn.addEventListener("click", () => scrollByCard(1));

    updateArrows();
    window.addEventListener("resize", updateArrows);
  }

  const lightbox = document.querySelector<HTMLElement>("[data-reviews-lightbox]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-close]");
  const prevLbBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-prev]");
  const nextLbBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-next]");
  const counter = document.querySelector<HTMLElement>("[data-reviews-lightbox-counter]");
  const slides = document.querySelectorAll<HTMLElement>("[data-reviews-lightbox-slide]");
  const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-review-open]");

  if (lightbox && closeBtn && prevLbBtn && nextLbBtn && counter && slides.length) {
    let current = 0;
    let trigger: HTMLElement | null = null;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => slide.classList.toggle("hidden", index !== current));
      counter.textContent = `${String(current + 1).padStart(2, "0")} / ${counter.dataset.total}`;
    };

    const openLightbox = (index: number, from: HTMLElement) => {
      trigger = from;
      show(index);
      lightbox.classList.replace("hidden", "flex");
      document.body.classList.add("overflow-hidden");
      closeBtn.focus();
    };

    const closeLightbox = () => {
      lightbox.classList.replace("flex", "hidden");
      document.body.classList.remove("overflow-hidden");
      trigger?.focus();
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        openLightbox(Number(button.dataset.index), button);
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    prevLbBtn.addEventListener("click", () => show(current - 1));
    nextLbBtn.addEventListener("click", () => show(current + 1));

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.classList.contains("hidden")) return;
      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    // Touch swipe navigation for mobile
    let touchStartX = 0;

    lightbox.addEventListener(
      "touchstart",
      (event) => {
        touchStartX = event.changedTouches[0].screenX;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      "touchend",
      (event) => {
        const delta = event.changedTouches[0].screenX - touchStartX;
        const SWIPE_THRESHOLD = 40;
        if (Math.abs(delta) < SWIPE_THRESHOLD) return;
        show(current + (delta < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>
