---
const REVIEWS_SOURCE_URL = "https://yandex.com/profile/189481176265?lang=ru";

const reviews = Array.from({ length: 4 }, (_, i) => ({
  src: `/images/review-${i + 1}.png`,
  index: i,
}));
---

<div class="mx-auto max-w-6xl px-4 pb-16 sm:px-8">
  <div class="mb-8 flex items-center gap-3">
    <span class="font-mono text-xs uppercase tracking-wide text-text-muted">
      отзывы · яндекс.карты
    </span>
    <span class="h-px flex-1 bg-line"></span>
  </div>

  <div class="relative">
    <div
      data-reviews-track
      class="no-scrollbar -mx-1 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth px-1 pb-2"
    >
      {
        reviews.map((review) => (
          <div class="w-full flex-none snap-start sm:w-[calc(50%-8px)] lg:w-[calc(25%-12px)]">
            <button
              type="button"
              data-review-open
              data-index={review.index}
              aria-label={`Открыть отзыв ${review.index + 1} крупнее`}
              class="group relative flex h-full w-full flex-col bg-surface p-4 text-left
                before:pointer-events-none before:absolute before:left-[10px] before:top-[10px] before:h-[10px] before:w-[10px] before:border-l before:border-t before:border-line-strong before:content-['']
                after:pointer-events-none after:absolute after:bottom-[10px] after:right-[10px] after:h-[10px] after:w-[10px] after:border-b after:border-r after:border-line-strong after:content-['']"
            >
              <div class="flex items-center justify-center bg-bg p-3">
                <img
                  src={review.src}
                  alt={`Скриншот отзыва ${review.index + 1} с Яндекс.Карт`}
                  loading="lazy"
                  class="max-h-40 w-full rounded-lg object-contain shadow-[0_8px_20px_rgba(0,0,0,0.35)] transition-transform duration-200 ease-out group-hover:scale-[1.02]"
                />
              </div>
              <div class="mt-3 flex items-center justify-between font-mono text-[11px] text-text-muted">
                <span>Яндекс.Карты</span>
                <span class="text-accent opacity-0 transition-opacity group-hover:opacity-100">
                  Увеличить →
                </span>
              </div>
            </button>
          </div>
        ))
      }
    </div>

    <button
      type="button"
      data-reviews-prev
      aria-label="Предыдущие отзывы"
      class="absolute left-0 top-1/2 hidden h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:flex"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <button
      type="button"
      data-reviews-next
      aria-label="Следующие отзывы"
      class="absolute right-0 top-1/2 hidden h-10 w-10 -translate-y-1/2 translate-x-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:flex"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <div class="mt-6 flex justify-center">
    <a
      href={REVIEWS_SOURCE_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-xs text-text-muted hover:text-accent"
    >
      Все отзывы на Яндекс.Картах →
    </a>
  </div>
</div>

<div
  data-reviews-lightbox
  role="dialog"
  aria-modal="true"
  aria-label="Просмотр отзыва"
  class="fixed inset-0 z-[80] hidden bg-bg/95"
>
  <button
    type="button"
    data-reviews-lightbox-close
    aria-label="Закрыть"
    class="absolute right-4 top-4 z-10 flex h-10 w-10 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
    </svg>
  </button>

  <button
    type="button"
    data-reviews-lightbox-prev
    aria-label="Предыдущий отзыв"
    class="absolute left-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:left-6"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <div class="flex h-full w-full items-center justify-center p-4 sm:p-10">
    <img
      data-reviews-lightbox-img
      src=""
      alt="Отзыв крупнее"
      class="max-h-full max-w-full rounded-lg object-contain shadow-[0_16px_40px_rgba(0,0,0,0.5)]"
    />
  </div>

  <button
    type="button"
    data-reviews-lightbox-next
    aria-label="Следующий отзыв"
    class="absolute right-2 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center border border-line-strong bg-bg text-text hover:text-accent sm:right-6"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

<style>
  .no-scrollbar {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-reviews-track]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-reviews-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-reviews-next]");

  const updateArrows = () => {
    if (!track || !prevBtn || !nextBtn) return;
    const hasOverflow = track.scrollWidth > track.clientWidth + 4;
    prevBtn.classList.toggle("sm:!hidden", !hasOverflow);
    nextBtn.classList.toggle("sm:!hidden", !hasOverflow);
  };

  if (track && prevBtn && nextBtn) {
    const scrollByCard = (direction: 1 | -1) => {
      const card = track.querySelector<HTMLElement>(":scope > div");
      const amount = card ? card.getBoundingClientRect().width + 16 : track.clientWidth;
      track.scrollBy({ left: amount * direction, behavior: "smooth" });
    };

    prevBtn.addEventListener("click", () => scrollByCard(-1));
    nextBtn.addEventListener("click", () => scrollByCard(1));

    updateArrows();
    window.addEventListener("resize", updateArrows);
  }

  const lightbox = document.querySelector<HTMLElement>("[data-reviews-lightbox]");
  const lightboxImg = document.querySelector<HTMLImageElement>("[data-reviews-lightbox-img]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-close]");
  const prevLbBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-prev]");
  const nextLbBtn = document.querySelector<HTMLButtonElement>("[data-reviews-lightbox-next]");
  const openButtons = document.querySelectorAll<HTMLButtonElement>("[data-review-open]");

  if (lightbox && lightboxImg && closeBtn && prevLbBtn && nextLbBtn && openButtons.length) {
    const images = Array.from(openButtons).map(
      (button) => button.querySelector("img")?.getAttribute("src") || "",
    );
    let current = 0;

    const show = (next: number) => {
      current = (next + images.length) % images.length;
      lightboxImg.src = images[current];
    };

    const openLightbox = (index: number) => {
      show(index);
      lightbox.classList.remove("hidden");
      document.body.classList.add("overflow-hidden");
    };

    const closeLightbox = () => {
      lightbox.classList.add("hidden");
      document.body.classList.remove("overflow-hidden");
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        openLightbox(Number(button.dataset.index));
      });
    });

    closeBtn.addEventListener("click", closeLightbox);
    prevLbBtn.addEventListener("click", () => show(current - 1));
    nextLbBtn.addEventListener("click", () => show(current + 1));

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.classList.contains("hidden")) return;
      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });
  }
</script>
