---
import ProductCard from "./ProductCard.astro";
import type { ProductWithUrlSlug } from "../lib/products";

interface Props {
  products: ProductWithUrlSlug[];
}

const { products } = Astro.props;
---

{
  products.length > 0 && (
    <div class="mt-14">
      <div class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-wide text-text-muted">
        <span>Похожие товары</span>
        <span class="h-px flex-1 bg-line" />
      </div>
      <div class="-mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:snap-none sm:grid-cols-2 sm:gap-3 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4">
        {products.map((product) => (
          <div class="w-[78%] shrink-0 snap-start sm:w-auto">
            <ProductCard product={product} disableSlider />
          </div>
        ))}
      </div>
    </div>
  )
}
