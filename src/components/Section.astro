---
// A home-page block drawn as a numbered "drawing sheet": full-width band with
// its own dark tint, a faint graph-paper grid, and a key color used for the
// sheet number and the leading segment of the dimension-line rule.

type Tone = "base" | "warm" | "steel" | "moss";

interface Props {
  id: string;
  title: string;
  index: number;
  total: number;
  tone: Tone;
  meta?: string;
  as?: "h1" | "h2";
}

const { id, title, index, total, tone, meta, as: Heading = "h2" } = Astro.props;

// Full literal class names so Tailwind can see them at build time.
const tones: Record<Tone, { band: string; keyText: string; keyBg: string }> = {
  base: { band: "bg-bg", keyText: "text-accent", keyBg: "bg-accent" },
  warm: { band: "bg-band-warm", keyText: "text-sand", keyBg: "bg-sand" },
  steel: { band: "bg-band-steel", keyText: "text-line-strong", keyBg: "bg-line-strong" },
  moss: { band: "bg-band-moss", keyText: "text-stock", keyBg: "bg-stock" },
};

const { band, keyText, keyBg } = tones[tone];
const pad = (n: number) => String(n).padStart(2, "0");
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class={`sheet relative scroll-mt-16 border-t border-line ${band}`}
>
  <div class="relative mx-auto max-w-6xl px-4 py-12 sm:px-8 sm:py-16">
    <header class="mb-8 sm:mb-10">
      <div class="flex items-center gap-3 font-mono text-xs uppercase tracking-wide">
        <span class={keyText}>{pad(index)}</span>
        <span class="text-text-muted">/ {pad(total)}</span>
        <span class="flex flex-1 items-center" aria-hidden="true">
          <span class={`h-px w-8 ${keyBg}`}></span>
          <span class="h-px flex-1 bg-line"></span>
        </span>
        {meta && <span class="text-text-muted">{meta}</span>}
      </div>
      <Heading
        id={headingId}
        class="mt-3 font-display text-2xl font-semibold text-text sm:text-3xl"
      >
        {title}
      </Heading>
    </header>

    <slot />
  </div>
</section>

<style>
  /* Graph paper in a barely-lighter shade of whatever band it sits on. */
  .sheet {
    background-image:
      linear-gradient(rgb(255 255 255 / 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
  }
</style>
