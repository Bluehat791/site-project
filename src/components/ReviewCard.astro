---
import ReviewAvatar from "./ReviewAvatar.astro";
import type { Review } from "../lib/reviews";

interface Props {
  review: Review;
  // "card" — compact, clamped text for the carousel; "full" — enlarged view in the modal.
  variant?: "card" | "full";
}

const { review, variant = "card" } = Astro.props;
const isFull = variant === "full";
const stars = Array.from({ length: 5 }, (_, i) => i < review.rating);
---

<article
  class={`relative flex h-full flex-col bg-surface ${isFull ? "p-6 sm:p-10" : "p-6"}
    before:pointer-events-none before:absolute before:left-[10px] before:top-[10px] before:h-[10px] before:w-[10px] before:border-l before:border-t before:border-line-strong before:content-['']
    after:pointer-events-none after:absolute after:bottom-[10px] after:right-[10px] after:h-[10px] after:w-[10px] after:border-b after:border-r after:border-line-strong after:content-['']`}
>
  <header class="flex items-center gap-3">
    <ReviewAvatar size={isFull ? "lg" : "md"} />
    <div class="min-w-0 pl-1">
      <p class={`truncate font-display font-medium text-text ${isFull ? "text-xl" : "text-base"}`}>
        {review.author}
      </p>
      <p class="font-mono text-[11px] text-text-muted">{review.date}</p>
    </div>
  </header>

  <div
    class="mt-4 flex items-center gap-2"
    role="img"
    aria-label={`Оценка ${review.rating} из 5`}
  >
    <span class="flex gap-0.5 text-sand" aria-hidden="true">
      {
        stars.map((filled) => (
          <svg
            width={isFull ? 18 : 14}
            height={isFull ? 18 : 14}
            viewBox="0 0 24 24"
            fill={filled ? "currentColor" : "none"}
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path d="M12 2.8l2.8 5.9 6.4.8-4.7 4.4 1.2 6.4L12 17.2l-5.7 3.1 1.2-6.4-4.7-4.4 6.4-.8z" stroke-linejoin="round" />
          </svg>
        ))
      }
    </span>
    <span class="font-mono text-xs text-text-muted" aria-hidden="true">
      {review.rating.toFixed(1)}
    </span>
  </div>

  <p
    class={isFull
      ? "mt-5 text-lg leading-relaxed text-text sm:text-xl"
      : "mt-3 line-clamp-4 text-[15px] leading-relaxed text-text"}
  >
    {review.text}
  </p>

  <footer class="mt-auto flex items-center justify-between pt-5 font-mono text-[11px] text-text-muted">
    <span>Яндекс.Карты</span>
    {
      !isFull && (
        <span class="text-accent opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
          Открыть →
        </span>
      )
    }
  </footer>
</article>
