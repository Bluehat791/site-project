---
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderSteps from "../components/OrderSteps.astro";
import TelegramButton from "../components/TelegramButton.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { faqItems } from "../data/faq";
import { PHONE_DISPLAY, PHONE_TEL } from "../lib/contacts";

const deliveryFaqItems = faqItems.filter((item) => item.onDeliveryPage);
---

<BaseLayout
  title="Доставка и оплата — Юггидросоюз"
  description="Условия доставки и оплаты в Юггидросоюз: заказ через Telegram или по телефону, без онлайн-оплаты на сайте."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-8">
    <nav aria-label="Хлебные крошки" class="mb-6 flex items-center gap-2 font-mono text-xs text-text-muted">
      <a href="/" class="hover:text-text">Главная</a>
      <span aria-hidden="true">→</span>
      <span class="text-text">Доставка и оплата</span>
    </nav>

    <h1 class="mb-6 font-display text-3xl font-semibold text-text">Доставка и оплата</h1>

    <div class="space-y-6 text-sm leading-relaxed text-text-muted sm:text-base">
      <div>
        <h2 class="mb-2 font-display text-lg font-medium text-text">Оформление заказа</h2>
        <p>
          Сайт работает как каталог: оплата и корзина на нём не предусмотрены.
          Чтобы оформить заказ, напишите в Telegram или позвоните — менеджер
          подтвердит наличие, цену и сроки по выбранной позиции.
        </p>
      </div>
    </div>

    <div class="mt-6 space-y-6 text-sm leading-relaxed text-text-muted sm:text-base">
      <div>
        <h2 class="mb-2 font-display text-lg font-medium text-text">Доставка</h2>
        <p>
          Доставка обсуждается индивидуально после подтверждения заказа — транспортной
          компанией, СДЭК или другим удобным способом в зависимости от региона и
          габаритов груза. Стоимость и сроки зависят от направления и уточняются
          менеджером.
        </p>
      </div>

      <div>
        <h2 class="mb-2 font-display text-lg font-medium text-text">Оплата</h2>
        <p>
          Способ оплаты (наличный расчёт, перевод на карту или по счёту для
          организаций) согласовывается с менеджером при оформлении заказа.
        </p>
      </div>
    </div>

    <div class="mt-10 border-t border-line pt-10">
      <h2 class="mb-6 font-display text-lg font-medium text-text">Как это работает</h2>
      <OrderSteps ymPlace="delivery_page">
        <a
          href={`tel:${PHONE_TEL}`}
          data-ym-goal="call_click"
          data-ym-place="delivery_page"
          class="flex items-center gap-2 border border-line-strong px-5 py-3 font-mono text-sm text-text hover:text-accent"
        >
          {PHONE_DISPLAY}
        </a>
      </OrderSteps>
    </div>

    <div class="mt-10 border-t border-line pt-10">
      <h2 class="mb-6 font-display text-lg font-medium text-text">Частые вопросы</h2>
      <FaqAccordion items={deliveryFaqItems} />
      <a
        href="/faq"
        class="mt-4 inline-flex items-center gap-2 font-mono text-sm text-text-muted hover:text-accent"
      >
        Все вопросы и ответы →
      </a>
    </div>
  </div>
</BaseLayout>
