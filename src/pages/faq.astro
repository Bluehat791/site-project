---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import TelegramButton from "../components/TelegramButton.astro";
import { faqItems } from "../data/faq";
import { PHONE_DISPLAY, PHONE_TEL } from "../lib/contacts";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Главная",
      item: new URL("/", Astro.site).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Вопросы и ответы",
      item: new URL("/faq", Astro.site).toString(),
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Вопросы и ответы — Юггидросоюз"
  description="Ответы на частые вопросы о заказе гидравлики и запчастей в Юггидросоюз: опт и розница, гарантия, доставка по регионам, работа с юрлицами, наличие и подбор аналогов."
>
  <JsonLd schema={breadcrumbSchema} />
  <JsonLd schema={faqSchema} />
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-8">
    <nav aria-label="Хлебные крошки" class="mb-6 flex items-center gap-2 font-mono text-xs text-text-muted">
      <a href="/" class="hover:text-text">Главная</a>
      <span aria-hidden="true">→</span>
      <span class="text-text">Вопросы и ответы</span>
    </nav>

    <h1 class="mb-3 font-display text-3xl font-semibold text-text">Вопросы и ответы</h1>
    <p class="mb-8 text-sm leading-relaxed text-text-muted sm:text-base">
      Частые вопросы о заказе, доставке и оплате. Не нашли ответ — напишите в
      Telegram или позвоните, ответим быстро.
    </p>

    <FaqAccordion items={faqItems} />

    <div class="mt-10 flex flex-wrap items-center gap-3 border-t border-line pt-8">
      <TelegramButton place="faq_page" />
      <a
        href={`tel:${PHONE_TEL}`}
        data-ym-goal="call_click"
        data-ym-place="faq_page"
        class="flex items-center gap-2 border border-line-strong px-5 py-3 font-mono text-sm text-text hover:text-accent"
      >
        {PHONE_DISPLAY}
      </a>
    </div>
  </div>
</BaseLayout>
