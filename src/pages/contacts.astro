---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  TELEGRAM_URL,
  WHATSAPP_URL,
  PHONE_DISPLAY,
  PHONE_TEL,
} from "../lib/contacts";
---

<BaseLayout
  title="Контакты — Юггидросоюз"
  description="Свяжитесь с Юггидросоюз в Telegram, WhatsApp или по телефону."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-8">
    <nav aria-label="Хлебные крошки" class="mb-6 flex items-center gap-2 font-mono text-xs text-text-muted">
      <a href="/" class="hover:text-text">Главная</a>
      <span aria-hidden="true">→</span>
      <span class="text-text">Контакты</span>
    </nav>

    <h1 class="mb-6 font-display text-3xl font-semibold text-text">Контакты</h1>

    <p class="mb-8 text-sm leading-relaxed text-text-muted sm:text-base">
      Заказ и вопросы по товарам — через Telegram, WhatsApp или по телефону.
      Оплата и корзина на сайте не предусмотрены.
    </p>

    <div class="grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-3">
      <a
        href={TELEGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center gap-2 bg-surface px-4 py-8 text-bg"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-accent" aria-hidden="true">
          <path d="M21.5 3.5l-19 7.3c-1 .4-1 1.1-.1 1.4l4.7 1.5 1.8 5.5c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.2-2.1 4.6 3.4c.8.5 1.4.2 1.6-.8l3-14.1c.3-1.3-.3-1.9-1.5-1.4z" />
        </svg>
        <span class="text-sm font-medium text-text">Telegram</span>
        <span class="font-mono text-xs text-text-muted">@Yugsoyuz</span>
      </a>
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center gap-2 bg-surface px-4 py-8"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-stock" aria-hidden="true">
          <path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.7 0-3.3-.5-4.6-1.3l-.3-.2-3 .9.9-2.9-.2-.3C4 14.8 3.5 13.4 3.5 12 3.5 7.3 7.3 3.5 12 3.5S20.5 7.3 20.5 12 16.7 20 12 20z" />
        </svg>
        <span class="text-sm font-medium text-text">WhatsApp</span>
        <span class="font-mono text-xs text-text-muted">{PHONE_DISPLAY}</span>
      </a>
      <a
        href={`tel:${PHONE_TEL}`}
        class="flex flex-col items-center justify-center gap-2 bg-surface px-4 py-8"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-text" aria-hidden="true">
          <path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1L6.6 10.8z" />
        </svg>
        <span class="text-sm font-medium text-text">Звонок</span>
        <span class="font-mono text-xs text-text-muted">{PHONE_DISPLAY}</span>
      </a>
    </div>
  </div>
</BaseLayout>
