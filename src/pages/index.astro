---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import GallerySection from "../components/GallerySection.astro";
import MapSection from "../components/MapSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import { allProducts } from "../lib/products";

// Filter only makes sense once products actually have distinct categories —
// ProductList.json currently has one placeholder category for everything
// (see CLAUDE.md "Known data quirks"), so this renders nothing for now.
const categories = [...new Set(allProducts.map((product) => product.category))];
const hasCategoryFilter = categories.length > 1;

const INITIAL_VISIBLE = 6;
const hasMore = allProducts.length > INITIAL_VISIBLE;
---

<BaseLayout
  title="Каталог товаров"
  description="Каталог запчастей и гидравлики для спецтехники."
>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-8">
    <h1 class="mb-8 font-display text-3xl font-semibold text-text">
      Каталог товаров
    </h1>

    {
      hasCategoryFilter && (
        <div
          class="mb-8 flex flex-wrap gap-2"
          data-category-filter
        >
          <button
            type="button"
            data-category="all"
            aria-pressed="true"
            class="border border-line px-4 py-2 font-mono text-xs text-text-muted aria-pressed:border-line-strong aria-pressed:text-text"
          >
            Все
          </button>
          {categories.map((category) => (
            <button
              type="button"
              data-category={category}
              aria-pressed="false"
              class="border border-line px-4 py-2 font-mono text-xs text-text-muted aria-pressed:border-line-strong aria-pressed:text-text"
            >
              {category}
            </button>
          ))}
        </div>
      )
    }

    <div
      class="grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
      data-product-grid
    >
      {
        allProducts.map((product, index) => (
          <div
            data-category={product.category}
            data-product-index={index}
            class={index >= INITIAL_VISIBLE ? "hidden" : ""}
          >
            <ProductCard product={product} />
          </div>
        ))
      }
    </div>

    {
      hasMore && (
        <div class="mt-8 flex justify-center">
          <button
            type="button"
            data-show-more
            data-expanded="false"
            class="border border-line-strong px-6 py-3 font-mono text-xs uppercase tracking-wide text-text hover:bg-surface"
          >
            Показать ещё
          </button>
        </div>
      )
    }
  </div>

  <GallerySection />
  <MapSection />
  <ReviewsSection />
</BaseLayout>

{
  hasMore && (
    <script>
      const button = document.querySelector<HTMLButtonElement>("[data-show-more]");
      const grid = document.querySelector("[data-product-grid]");

      if (button && grid) {
        const INITIAL_VISIBLE = 6;

        button.addEventListener("click", () => {
          const isExpanded = button.dataset.expanded === "true";
          const items = grid.querySelectorAll<HTMLElement>("[data-product-index]");

          items.forEach((item, index) => {
            if (isExpanded) {
              // Collapse: hide items beyond initial count
              if (index >= INITIAL_VISIBLE) {
                item.classList.add("hidden");
              }
            } else {
              // Expand: show all items
              item.classList.remove("hidden");
            }
          });

          // Toggle state
          const newExpanded = !isExpanded;
          button.dataset.expanded = String(newExpanded);
          button.textContent = newExpanded ? "Свернуть" : "Показать ещё";
        });
      }
    </script>
  )
}

{
  hasCategoryFilter && (
    <script>
      const filterBar = document.querySelector("[data-category-filter]");
      const grid = document.querySelector("[data-product-grid]");

      if (filterBar && grid) {
        const buttons = filterBar.querySelectorAll("button[data-category]");
        const items = grid.querySelectorAll<HTMLElement>("[data-category]");

        filterBar.addEventListener("click", (event) => {
          const button = (event.target as HTMLElement).closest(
            "button[data-category]",
          );
          if (!button) return;

          const selected = button.getAttribute("data-category");
          buttons.forEach((b) =>
            b.setAttribute("aria-pressed", String(b === button)),
          );
          items.forEach((item) => {
            const match =
              selected === "all" || item.getAttribute("data-category") === selected;
            item.style.display = match ? "" : "none";
          });
        });
      }
    </script>
  )
}
