---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import GallerySection from "../components/GallerySection.astro";
import MapSection from "../components/MapSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import Section from "../components/Section.astro";
import { allProducts } from "../lib/products";

// Filter only makes sense once products actually have distinct categories —
// ProductList.json currently has one placeholder category for everything
// (see CLAUDE.md "Known data quirks"), so this renders nothing for now.
const categories = [...new Set(allProducts.map((product) => product.category))];
const hasCategoryFilter = categories.length > 1;

const INITIAL_VISIBLE = 6;
const PAGE_SIZE = 9;
const hasMore = allProducts.length > INITIAL_VISIBLE;

const SECTION_COUNT = 4;
---

<BaseLayout
  title="Каталог товаров"
  description="Каталог запчастей и гидравлики для спецтехники."
>
  <Section
    id="catalog"
    as="h1"
    title="Каталог товаров"
    index={1}
    total={SECTION_COUNT}
    tone="base"
    meta={`позиций · ${allProducts.length}`}
  >

    {
      hasCategoryFilter && (
        <div
          class="mb-8 flex flex-wrap gap-2"
          data-category-filter
        >
          <button
            type="button"
            data-category="all"
            aria-pressed="true"
            class="border border-line px-4 py-2 font-mono text-xs text-text-muted aria-pressed:border-line-strong aria-pressed:text-text"
          >
            Все
          </button>
          {categories.map((category) => (
            <button
              type="button"
              data-category={category}
              aria-pressed="false"
              class="border border-line px-4 py-2 font-mono text-xs text-text-muted aria-pressed:border-line-strong aria-pressed:text-text"
            >
              {category}
            </button>
          ))}
        </div>
      )
    }

    <div
      class="grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
      data-product-grid
    >
      {
        allProducts.map((product, index) => (
          <div
            data-category={product.category}
            data-product-index={index}
            class={index >= INITIAL_VISIBLE ? "hidden" : ""}
          >
            <ProductCard product={product} />
          </div>
        ))
      }
    </div>

    {
      hasMore && (
        <div
          class="mt-8 flex flex-col items-center gap-3"
          data-catalog-controls
          data-initial={INITIAL_VISIBLE}
          data-page-size={PAGE_SIZE}
        >
          <div class="flex flex-wrap justify-center gap-3">
            <button
              type="button"
              data-show-more
              class="border border-line-strong px-6 py-3 font-mono text-xs uppercase tracking-wide text-text hover:bg-surface"
            >
              Показать ещё
            </button>
            <button
              type="button"
              data-collapse
              class="hidden border border-line px-6 py-3 font-mono text-xs uppercase tracking-wide text-text-muted hover:border-line-strong hover:text-text"
            >
              Свернуть
            </button>
          </div>
          <span
            data-catalog-counter
            aria-live="polite"
            class="font-mono text-[11px] text-text-muted"
          ></span>
        </div>
      )
    }
  </Section>

  <Section id="gallery" title="Наша галерея" index={2} total={SECTION_COUNT} tone="warm" meta="склад и витрина">
    <GallerySection />
  </Section>

  <Section id="map" title="Мы на карте" index={3} total={SECTION_COUNT} tone="steel" meta="как добраться">
    <MapSection />
  </Section>

  <Section id="reviews" title="Отзывы" index={4} total={SECTION_COUNT} tone="moss" meta="яндекс.карты">
    <ReviewsSection />
  </Section>
</BaseLayout>

{
  hasMore && (
    <script>
      const controls = document.querySelector<HTMLElement>("[data-catalog-controls]");
      const grid = document.querySelector("[data-product-grid]");
      const moreBtn = controls?.querySelector<HTMLButtonElement>("[data-show-more]");
      const collapseBtn = controls?.querySelector<HTMLButtonElement>("[data-collapse]");
      const counter = controls?.querySelector<HTMLElement>("[data-catalog-counter]");

      if (controls && grid && moreBtn && collapseBtn && counter) {
        const initial = Number(controls.dataset.initial);
        const pageSize = Number(controls.dataset.pageSize);
        const items = grid.querySelectorAll<HTMLElement>("[data-product-index]");
        const total = items.length;
        let visible = initial;

        const render = () => {
          items.forEach((item, index) => {
            item.classList.toggle("hidden", index >= visible);
          });

          const remaining = total - visible;
          moreBtn.classList.toggle("hidden", remaining <= 0);
          moreBtn.textContent = `Показать ещё ${Math.min(pageSize, remaining)}`;
          collapseBtn.classList.toggle("hidden", visible <= initial);
          counter.textContent = `показано ${Math.min(visible, total)} из ${total}`;
        };

        moreBtn.addEventListener("click", () => {
          const firstNew = items[visible];
          visible = Math.min(visible + pageSize, total);
          render();
          // Move focus to the first newly revealed card so keyboard users continue from there.
          firstNew?.querySelector<HTMLElement>("a")?.focus({ preventScroll: true });
        });

        collapseBtn.addEventListener("click", () => {
          visible = initial;
          render();
          // The list may have been very long — jump back to the top of the catalog.
          document.getElementById("catalog")?.scrollIntoView({ behavior: "smooth" });
        });

        render();
      }
    </script>
  )
}

{
  hasCategoryFilter && (
    <script>
      const filterBar = document.querySelector("[data-category-filter]");
      const grid = document.querySelector("[data-product-grid]");

      if (filterBar && grid) {
        const buttons = filterBar.querySelectorAll("button[data-category]");
        const items = grid.querySelectorAll<HTMLElement>("[data-category]");

        filterBar.addEventListener("click", (event) => {
          const button = (event.target as HTMLElement).closest(
            "button[data-category]",
          );
          if (!button) return;

          const selected = button.getAttribute("data-category");
          buttons.forEach((b) =>
            b.setAttribute("aria-pressed", String(b === button)),
          );
          items.forEach((item) => {
            const match =
              selected === "all" || item.getAttribute("data-category") === selected;
            item.style.display = match ? "" : "none";
          });
        });
      }
    </script>
  )
}
