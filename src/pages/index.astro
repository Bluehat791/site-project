---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import GallerySection from "../components/GallerySection.astro";
import MapSection from "../components/MapSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import OrderSteps from "../components/OrderSteps.astro";
import Section from "../components/Section.astro";
import TrustStats from "../components/TrustStats.astro";
import TelegramButton from "../components/TelegramButton.astro";
import { allProducts } from "../lib/products";
import { trustStats } from "../data/trustStats";

const INITIAL_VISIBLE = 6;
const PAGE_SIZE = 9;
const hasMore = allProducts.length > INITIAL_VISIBLE;

// Search index built at build time: one lowercased "name + model" string per
// product, keyed by its position in allProducts (matches data-product-index
// on the grid items below). Plain substring match, no external libs.
const searchIndex = allProducts.map((product, index) => ({
  index,
  text: `${product.name} ${product.slug}`.toLocaleLowerCase("ru"),
}));

const SECTION_COUNT = 5;
---

<BaseLayout
  title="Каталог товаров"
  description="Каталог запчастей и гидравлики для спецтехники."
>
  <Section
    id="catalog"
    as="h1"
    title="Каталог товаров"
    index={1}
    total={SECTION_COUNT}
    tone="base"
    meta={`позиций · ${allProducts.length}`}
  >

    <div class="mb-8" data-catalog-search>
      <div class="relative">
        <svg
          class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-text-muted"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path d="M21 21l-4.3-4.3" stroke-linecap="round" />
        </svg>
        <input
          type="search"
          inputmode="search"
          data-search-input
          placeholder="Поиск по названию или модели…"
          aria-label="Поиск по каталогу"
          class="w-full border border-line bg-transparent py-3 pl-11 pr-4 font-sans text-sm text-text placeholder:text-text-muted focus:border-accent focus:outline-none"
        />
      </div>
      <div
        data-search-counter
        aria-live="polite"
        class="mt-2 hidden font-mono text-[11px] text-text-muted"
      ></div>
    </div>

    <div
      class="grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3"
      data-product-grid
    >
      {
        allProducts.map((product, index) => (
          <div
            data-product-index={index}
            class={index >= INITIAL_VISIBLE ? "hidden" : ""}
          >
            <ProductCard product={product} />
          </div>
        ))
      }
    </div>

    <div class="hidden border border-line bg-surface px-6 py-10 text-center" data-search-empty>
      <p class="font-display text-lg text-text">Ничего не найдено</p>
      <p class="mx-auto mt-2 max-w-md text-sm text-text-muted">
        Возможно, у нас есть аналог — напишите нам, поможем подобрать замену.
      </p>
      <TelegramButton place="catalog_search_empty" class="mx-auto mt-5 w-fit" />
    </div>

    {
      hasMore && (
        <div
          class="mt-8 flex flex-col items-center gap-3"
          data-catalog-controls
          data-initial={INITIAL_VISIBLE}
          data-page-size={PAGE_SIZE}
        >
          <div class="flex flex-wrap justify-center gap-3">
            <button
              type="button"
              data-show-more
              class="border border-line-strong px-6 py-3 font-mono text-xs uppercase tracking-wide text-text hover:bg-surface"
            >
              Показать ещё
            </button>
            <button
              type="button"
              data-collapse
              class="hidden border border-line px-6 py-3 font-mono text-xs uppercase tracking-wide text-text-muted hover:border-line-strong hover:text-text"
            >
              Свернуть
            </button>
          </div>
          <span
            data-catalog-counter
            aria-live="polite"
            class="font-mono text-[11px] text-text-muted"
          ></span>
        </div>
      )
    }
  </Section>

  <Section id="how-to-order" title="Как заказать" index={2} total={SECTION_COUNT} tone="base" meta="каталог-визитка, не магазин">
    <OrderSteps ymPlace="home_how_to_order" />
  </Section>

  <Section id="gallery" title="Наша галерея" index={3} total={SECTION_COUNT} tone="warm" meta="склад и витрина">
    <GallerySection />
  </Section>

  <Section id="map" title="Мы на карте" index={4} total={SECTION_COUNT} tone="steel" meta="как добраться">
    <MapSection />
  </Section>

  <TrustStats stats={trustStats} />

  <Section id="reviews" title="Отзывы" index={5} total={SECTION_COUNT} tone="moss" meta="яндекс.карты">
    <ReviewsSection />
  </Section>
</BaseLayout>


<script define:vars={{ searchIndex, initial: INITIAL_VISIBLE, pageSize: PAGE_SIZE }}>
  const grid = document.querySelector("[data-product-grid]");
  const items = grid ? grid.querySelectorAll("[data-product-index]") : [];
  const total = items.length;

  const controls = document.querySelector("[data-catalog-controls]");
  const moreBtn = controls?.querySelector("[data-show-more]");
  const collapseBtn = controls?.querySelector("[data-collapse]");
  const paginationCounter = controls?.querySelector("[data-catalog-counter]");

  const searchInput = document.querySelector("[data-search-input]");
  const searchCounter = document.querySelector("[data-search-counter]");
  const emptyState = document.querySelector("[data-search-empty]");

  let visible = initial;

  const renderPagination = () => {
    items.forEach((item, index) => {
      item.classList.toggle("hidden", index >= visible);
    });

    if (controls && moreBtn && collapseBtn && paginationCounter) {
      const remaining = total - visible;
      moreBtn.classList.toggle("hidden", remaining <= 0);
      moreBtn.textContent = `Показать ещё ${Math.min(pageSize, remaining)}`;
      collapseBtn.classList.toggle("hidden", visible <= initial);
      paginationCounter.textContent = `показано ${Math.min(visible, total)} из ${total}`;
    }
  };

  const applySearch = (query) => {
    const q = query.trim().toLocaleLowerCase("ru");

    if (!q) {
      controls?.classList.remove("hidden");
      searchCounter?.classList.add("hidden");
      emptyState?.classList.add("hidden");
      grid?.classList.remove("hidden");
      visible = initial;
      renderPagination();
      return;
    }

    controls?.classList.add("hidden");
    const matched = new Set(
      searchIndex.filter((entry) => entry.text.includes(q)).map((entry) => entry.index),
    );

    items.forEach((item, index) => {
      item.classList.toggle("hidden", !matched.has(index));
    });

    if (searchCounter) {
      searchCounter.textContent = `найдено ${matched.size} из ${total}`;
      searchCounter.classList.remove("hidden");
    }
    emptyState?.classList.toggle("hidden", matched.size > 0);
    grid?.classList.toggle("hidden", matched.size === 0);
  };

  if (moreBtn && collapseBtn) {
    moreBtn.addEventListener("click", () => {
      const firstNew = items[visible];
      visible = Math.min(visible + pageSize, total);
      renderPagination();
      // Move focus to the first newly revealed card so keyboard users continue from there.
      firstNew?.querySelector("a")?.focus({ preventScroll: true });
    });

    collapseBtn.addEventListener("click", () => {
      visible = initial;
      renderPagination();
      // The list may have been very long — jump back to the top of the catalog.
      document.getElementById("catalog")?.scrollIntoView({ behavior: "smooth" });
    });
  }

  searchInput?.addEventListener("input", (event) => {
    applySearch(event.target.value);
  });

  renderPagination();
</script>
