---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { allProducts, getProductByUrlSlug } from "../../lib/products";
import {
  TELEGRAM_URL,
  WHATSAPP_URL,
  PHONE_DISPLAY,
  PHONE_TEL,
} from "../../lib/contacts";

export function getStaticPaths() {
  return allProducts.map((product) => ({
    params: { slug: product.urlSlug },
  }));
}

const { slug } = Astro.params;
const product = getProductByUrlSlug(slug!);

if (!product) {
  throw new Error(`Product not found for slug: ${slug}`);
}

const images = product.images;
const cover = images[0];
const priceLabel =
  product.price > 0
    ? `${product.price.toLocaleString("ru-RU")} ₽`
    : "Цена по запросу";
const specEntries = Object.entries(product.specifications);
---

<BaseLayout
  title={`${product.name} — купить`}
  description={product.shortDescription}
>
  <div class="mx-auto max-w-6xl px-4 pb-28 pt-8 sm:px-8 sm:pt-10 lg:pb-16">
    <nav aria-label="Хлебные крошки" class="mb-6 flex flex-wrap items-center gap-2 font-mono text-xs text-text-muted">
      <a href="/" class="hover:text-text">Главная</a>
      <span aria-hidden="true">→</span>
      <span>{product.category}</span>
      <span aria-hidden="true">→</span>
      <span class="text-text">{product.name}</span>
    </nav>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
      <div data-gallery>
        <div class="lg:flex lg:gap-3">
          {
            images.length > 1 && (
              <div class="order-2 mt-3 flex gap-2 overflow-x-auto lg:order-1 lg:mt-0 lg:max-h-[560px] lg:w-20 lg:flex-col lg:overflow-x-visible lg:overflow-y-auto">
                {images.map((src, i) => (
                  <button
                    type="button"
                    data-gallery-thumb
                    data-src={src}
                    aria-label={`Фото ${i + 1}`}
                    class={`h-16 w-16 shrink-0 border bg-surface-2 lg:h-20 lg:w-20 ${
                      i === 0
                        ? "border-line-strong opacity-100"
                        : "border-line opacity-70"
                    }`}
                  >
                    <img
                      src={src}
                      alt=""
                      loading="lazy"
                      class="h-full w-full object-cover"
                    />
                  </button>
                ))}
              </div>
            )
          }

          <div class="order-1 relative aspect-square w-full overflow-hidden border border-line bg-surface-2 lg:order-2 lg:flex-1">
            {
              cover && (
                <img
                  data-gallery-main
                  src={cover}
                  alt={product.name}
                  class="h-full w-full object-cover"
                />
              )
            }
          </div>
        </div>
      </div>

      <div class="flex flex-col">
        <div class="mb-2 font-mono text-xs uppercase tracking-wide text-line-strong">
          {product.category}
        </div>
        <h1 class="mb-5 font-display text-2xl font-semibold leading-tight text-text sm:text-3xl">
          {product.name}
        </h1>

        <div class="relative border border-line bg-surface p-6
          before:pointer-events-none before:absolute before:left-[10px] before:top-[10px] before:h-[10px] before:w-[10px] before:border-l before:border-t before:border-line-strong before:content-['']
          after:pointer-events-none after:absolute after:bottom-[10px] after:right-[10px] after:h-[10px] after:w-[10px] after:border-b after:border-r after:border-line-strong after:content-['']"
        >
          <div class="mb-2 flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <span class="font-mono text-3xl font-medium text-text sm:text-4xl">
              {priceLabel}
            </span>
            <span class={`flex items-center gap-1.5 text-sm ${product.inStock ? "text-stock" : "text-text-muted"}`}>
              <span aria-hidden="true">●</span>
              {product.inStock ? "В наличии" : "Под заказ"}
            </span>
          </div>

          <div class="mt-5 grid grid-cols-3 gap-2">
            <a
              href={TELEGRAM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center gap-1.5 bg-accent px-2 py-3.5 text-bg"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M21.5 3.5l-19 7.3c-1 .4-1 1.1-.1 1.4l4.7 1.5 1.8 5.5c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.2-2.1 4.6 3.4c.8.5 1.4.2 1.6-.8l3-14.1c.3-1.3-.3-1.9-1.5-1.4z" />
              </svg>
              <span class="text-xs font-medium">Telegram</span>
            </a>
            <a
              href={WHATSAPP_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col items-center justify-center gap-1.5 border border-line-strong px-2 py-3.5 text-text hover:border-stock hover:text-stock"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.5 2 2 6.5 2 12c0 1.9.5 3.7 1.5 5.3L2 22l4.8-1.5C8.3 21.5 10.1 22 12 22c5.5 0 10-4.5 10-10S17.5 2 12 2zm0 18c-1.7 0-3.3-.5-4.6-1.3l-.3-.2-3 .9.9-2.9-.2-.3C4 14.8 3.5 13.4 3.5 12 3.5 7.3 7.3 3.5 12 3.5S20.5 7.3 20.5 12 16.7 20 12 20z" />
              </svg>
              <span class="text-xs font-medium">WhatsApp</span>
            </a>
            <a
              href={`tel:${PHONE_TEL}`}
              class="flex flex-col items-center justify-center gap-1.5 border border-line-strong px-2 py-3.5 text-text hover:border-line-strong hover:text-accent"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1L6.6 10.8z" />
              </svg>
              <span class="text-xs font-medium">Звонок</span>
            </a>
          </div>

          <div class="mt-4 font-mono text-xs text-text-muted">
            {PHONE_DISPLAY}
          </div>
        </div>

        <p class="mt-6 text-sm leading-relaxed text-text-muted">
          {product.shortDescription}
        </p>
      </div>
    </div>

    <div class="mt-14">
      <div class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-wide text-text-muted">
        <span>Описание</span>
        <span class="h-px flex-1 bg-line"></span>
      </div>
      <p class="whitespace-pre-line text-sm leading-relaxed text-text-muted sm:text-base">
        {product.fullDescription}
      </p>
    </div>

    {
      specEntries.length > 0 && (
        <div class="mt-14">
          <div class="mb-5 flex items-center gap-3 font-mono text-xs uppercase tracking-wide text-text-muted">
            <span>Характеристики</span>
            <span class="h-px flex-1 bg-line" />
          </div>
          <div class="border border-line">
            {specEntries.map(([key, value], i) => (
              <div
                class={`flex justify-between gap-4 px-4 py-3 ${i > 0 ? "border-t border-line" : ""} ${i % 2 === 1 ? "bg-surface" : ""}`}
              >
                <span class="text-sm text-text-muted">{key}</span>
                <span class="font-mono text-sm text-text">{value}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>

  <div class="fixed inset-x-0 bottom-0 z-40 flex items-center gap-3 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur lg:hidden">
    <span class="shrink-0 font-mono text-base font-medium text-text">
      {priceLabel}
    </span>
    <a
      href={TELEGRAM_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="flex flex-1 items-center justify-center gap-2 bg-accent px-4 py-3 text-sm font-medium text-bg"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M21.5 3.5l-19 7.3c-1 .4-1 1.1-.1 1.4l4.7 1.5 1.8 5.5c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.2-2.1 4.6 3.4c.8.5 1.4.2 1.6-.8l3-14.1c.3-1.3-.3-1.9-1.5-1.4z" />
      </svg>
      Написать в Telegram
    </a>
    <a
      href={`tel:${PHONE_TEL}`}
      aria-label="Позвонить"
      class="flex h-11 w-11 shrink-0 items-center justify-center border border-line-strong text-text"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.5 6.5l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.3 0 .7-.2 1L6.6 10.8z" />
      </svg>
    </a>
  </div>
</BaseLayout>

<script>
  const galleries = document.querySelectorAll<HTMLElement>("[data-gallery]");

  galleries.forEach((gallery) => {
    const main = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    if (!main) return;

    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const src = thumb.dataset.src;
        if (!src) return;
        main.src = src;
        thumbs.forEach((t) => {
          t.classList.remove("border-line-strong", "opacity-100");
          t.classList.add("border-line", "opacity-70");
        });
        thumb.classList.remove("border-line", "opacity-70");
        thumb.classList.add("border-line-strong", "opacity-100");
      });
    });
  });
</script>
